@model UpdateAboutDto
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="card-title">Hakkımızda Düzenle</div>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Title">Başlık</label>
                <input type="text" class="form-control" asp-for="Title" required />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl">Görsel</label>
                <input type="text" class="form-control" asp-for="ImageUrl" required />
            </div>
            <div class="form-group">
                <label asp-for="Description">Açıklama</label>
                <textarea type="text" class="form-control"  required style="height: 300px;" asp-for="Description">
                    @Html.Raw(Model.Description.Replace("\n", "<br />"))
                </textarea>
            </div>            
            <button class="btn btn-outline-primary btn-rounded mb-3 mt-2 px-5">Kaydet</button>
        </form>
    </div>
</div>


