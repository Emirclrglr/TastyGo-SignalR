						<td class="text-center">@item.Email</td>
						<td class="text-center">@item.NumberOfPeople</td>
						<td class="text-center">@item.Date.ToString("dd MMMM, yyyy HH:mm")</td>
						<td class="text-center"><a href="/Admin/Booking/UpdateBooking/@item.Id" class="btn btn-outline-primary btn-rounded">Düzenle</a></td>
