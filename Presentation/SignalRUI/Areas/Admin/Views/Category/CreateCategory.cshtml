@model CreateCategoryDto
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="card-title">Yeni Kategori Oluştur</div>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group">
                <label asp-for="CategoryName">Kategori Adı</label>
                <input type="text" class="form-control" asp-for="CategoryName" required/>
            </div>
            <div class="form-group pt-0">
                <label asp-for="Status">Durum</label>
                <select class="form-control" asp-for="Status">
                    <option value="1">Aktif</option>
                    <option value="0">Pasif</option>
                </select>
            </div>
            <button class="btn btn-outline-primary btn-rounded mb-3 mt-2 px-5">Kaydet</button>
        </form>
    </div>
</div>
