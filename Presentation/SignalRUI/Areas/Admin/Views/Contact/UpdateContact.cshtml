@model UpdateContactDto
@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mb-5">
    <div class="card-header">
        <div class="card-title">İletişim Düzenle</div>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group pt-0">
                <label asp-for="Location">Lokasyon</label>
                <input type="text" class="form-control" asp-for="Location" required />
            </div>
            <div class="form-group pt-0">
                <label asp-for="Phone">Telefon</label>
                <input type="text" class="form-control" asp-for="Phone" required />
            </div>
            <div class="form-group pt-0">
                <label asp-for="Email">E-Posta</label>
                <input type="email" class="form-control" asp-for="Email" required />
            </div>
            <div class="form-group pt-0">
                <label asp-for="FooterDescriptionTitle">Alt Açıklama Başlık</label>
                <input type="text" class="form-control" asp-for="FooterDescriptionTitle" required />
            </div>
            <div class="form-group pt-0">
                <label asp-for="FooterDescription">Alt Açıklama</label>
                <textarea type="text" class="form-control" required style="height: 300px;" asp-for="FooterDescription">
                    @Html.Raw(Model.FooterDescription.Replace("\n", "<br />"))
                </textarea>
            </div>
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="OpenDays">Açılış Günleri</label>
                        <input type="text" class="form-control" asp-for="OpenDays" required />
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="OpenDaysDescription">Gün</label>
                        <input type="text" class="form-control" asp-for="OpenDaysDescription" required />
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="OpeningHours">Açılış Saatleri</label>
                        <input type="text" class="form-control" asp-for="OpeningHours" required />
                    </div>
                </div>
            </div>
            <button class="btn btn-outline-primary btn-rounded mb-3 mt-3 px-5">Kaydet</button>
        </form>
    </div>
</div>
