@model CreateFeatureDto
@{
    ViewData["Title"] = "CreateFeature";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="card-title">Öne Çıkan Oluştur</div>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group">
                <label asp-for="Title">Başlık</label>
                <input type="text" class="form-control" asp-for="Title" required />
            </div>
            <div class="form-group pt-0">
                <label asp-for="Description">Açıklama</label>
                <textarea type="text" class="form-control" style="height: 300px" asp-for="Description" required></textarea>
            </div>
            <button class="btn btn-outline-primary btn-rounded mb-3 mt-2 px-5">Kaydet</button>
        </form>
    </div>
</div>

