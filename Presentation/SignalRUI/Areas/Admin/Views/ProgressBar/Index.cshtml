
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script type="text/javascript">
    $(document).ready(() => {
        var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:44314/SignalRHub").build();

        connection.start().then(() => {

            setInterval(() => {
                connection.invoke("SendProgress");
            }, 1000);

        }).catch((err) => {
            console.log(err);
        });

        connection.on("ReceiveMoneySafeTotalAmount", (moneySafeTotalAmountValue) => {
            $("#totalBalance").text(moneySafeTotalAmountValue);
        });

        connection.on("ReceiveActiveOrderCount", (activeOrderCountValue) => {
            $("#activeOrders").text(activeOrderCountValue);
        });

        connection.on("ReceiveDiningTableCount", (diningTableCountValue) => {
            $("#activeDiningTable").text(diningTableCountValue);
        });

        connection.on("ReceiveTotalProductPrice", (totalProductPrice) => {
            $("#totalProductPrice").text(totalProductPrice);
        });

        connection.on("ReceiveAvgProductPrice", (avgProductPrice) => {
            $("#avgProductPrice").text(avgProductPrice);
        });

         connection.on("ReceivePriceOfLastOrder", (totalPriceOfLatestOrder) => {
            $("#totalPriceOfLatestOrder").text(totalPriceOfLatestOrder);
        });

        connection.on("ReceiveCategoryCount", (categoryCount) => {
            $("#categoryCount").text(categoryCount);
        });

        connection.on("ReceiveProductCount", (productCount) => {
            $("#productCount").text(productCount);
        });

         connection.on("ReceiveBookingCount", (bookingCount) => {
            $("#bookingCount").text(bookingCount);
        });

        connection.on("ReceiveAvgDiscountRate", (avgDiscountRate) => {
            $("#avgDiscountRate").text(avgDiscountRate);
        });

        connection.on("ReceiveMessageCount", (messageCount) => {
            $("#messageCount").text(messageCount);
        });

        connection.on("ReceiveTestimonialCount", (testimonialCount) => {
            $("#testimonialCount").text(testimonialCount);
        });

        connection.on("ReceiveDiningTableCount", (diningTableCountValue2) => {
            $("#totalMenuTableCountProgress").empty();
            $("#totalMenuTableCountProgress").append(`
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Toplam Masa Sayısı</span>
                    <span class="text-muted fw-bold">${diningTableCountValue2}</span>
                </div>
                <div class="progress mb-2" style="height: 7px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: ${diningTableCountValue2}%" aria-valuenow="${diningTableCountValue2}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${diningTableCountValue2}%">
                    </div>
                </div>
            `);
        });

        connection.on("ReceiveAvgProductPrice", (avgProductPrice) => {
            $("#avgProductPriceProgress").empty();
            $("#avgProductPriceProgress").append(`
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Ortalama Ürün Fiyatı</span>
                    <span class="text-muted fw-bold">${avgProductPrice} ₺</span>
                </div>
                <div class="progress mb-2" style="height: 7px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: ${avgProductPrice}%" aria-valuenow="${avgProductPrice}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${avgProductPrice}%">
                    </div>
                </div>
            `);
        });

        connection.on("ReceiveDrinkCount", (drinkCount) => {
            $("#drinkCountProgress").empty();
            $("#drinkCountProgress").append(`
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Toplam İçecek Sayısı</span>
                    <span class="text-muted fw-bold">${drinkCount}</span>
                </div>
                <div class="progress mb-2" style="height: 7px;">
                    <div class="progress-bar bg-secondary" role="progressbar" style="width: ${drinkCount}%" aria-valuenow="${drinkCount}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${drinkCount}%">
                    </div>
                </div>
            `);
        });

        connection.on("ReceiveAvgHamburgerPrice", (avgHamburgerPrice) => {
            $("#avgHamburgerPriceProgress").empty();
            $("#avgHamburgerPriceProgress").append(`
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Ortalama Hamburger Fiyatı</span>
                    <span class="text-muted fw-bold">${avgHamburgerPrice} ₺</span>
                </div>
                <div class="progress mb-2" style="height: 7px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: ${avgHamburgerPrice}%" aria-valuenow="${avgHamburgerPrice}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${avgHamburgerPrice}%">
                    </div>
                </div>
            `);
        });

    });
</script>

<div class="row row-card-no-pd mb-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h4>Dashboard</h4></div>
            <div class="card-body">
                <p class="fw-bold mt-1">Kasadaki Bakiye</p>
                <h4><b id="totalBalance"></b> ₺</h4>
            </div>
            <div class="card-body">
                <p class="fw-bold mt-1">Toplam Ürün Fiyatı</p>
                <h4><b id="totalProductPrice"></b> ₺</h4>
            </div>

            <div class="card-body">
                <p class="fw-bold mt-1">Ortalama Ürün Fiyatı</p>
                <h4><b id="avgProductPrice"></b> ₺</h4>
            </div>

            <div class="card-body">
                <p class="fw-bold mt-1">Ortalama İndirim Oranı</p>
                <h4><b id="avgDiscountRate"></b> %</h4>
            </div>

            <div class="card-body">
                <p class="fw-bold mt-1">Son Sipariş Tutarı</p>
                <h4><b id="totalPriceOfLatestOrder"></b> ₺</h4>
                <a href="/Admin/Order/CreateOrder/" class="btn btn-primary btn-full text-left mt-3 mb-3"><i class="la la-plus"></i> Yeni Sipariş</a>
            </div>

            <div class="card-footer">
                <ul class="nav">
                    <li class="nav-item"><a class="btn btn-default btn-link" href="/Admin/Order/Index/"><i class="las la-utensils"></i> Siparişler</a></li>
                    <li class="nav-item ml-auto"><a class="btn btn-default btn-link" href="/Admin/ProgressBar/Index"><i class="la la-refresh"></i> Sayfayı Yenile</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">

                <div id="totalMenuTableCountProgress" class="progress-card"></div>

                <div id="avgProductPriceProgress" class="progress-card"></div>

                <div id="drinkCountProgress" class="progress-card"></div>

                <div id="avgHamburgerPriceProgress" class="progress-card"></div>
            </div>

            <div class="embed-responsive embed-responsive-4by3">
                <iframe  class="embed-responsive-item" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4403.509515704837!2d28.993577254403935!3d41.03975482960668!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab776f9715eeb%3A0x2cef984e492e1bd8!2zVMO8cHJhxZ8gU3RhZHl1bXU!5e1!3m2!1str!2sus!4v1739357833686!5m2!1str!2sus" style="border:0;" allowfullscreen="allowfullscreen" loading="eager" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stats">
            <div class="card-body">
                <p class="fw-bold mt-1">İstatistikler</p>
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-concierge-bell text-warning"></i>                       
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Aktif Siparişler</p>
                            <h4 class="card-title" id="activeOrders"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center">
                            <i class="las la-utensils text-primary"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Masa Sayısı</p>
                            <h4 class="card-title" id="activeDiningTable"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-table text-danger"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Kategori Sayısı</p>
                            <h4 class="card-title" id="categoryCount"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-hamburger text-info"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Ürün Sayısı</p>
                            <h4 class="card-title" id="productCount"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-calendar-check text-success"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Rezervasyon Sayısı</p>
                            <h4 class="card-title" id="bookingCount"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-comments text-secondary"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Mesaj Sayısı</p>
                            <h4 class="card-title" id="messageCount"></h4>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center icon-warning">
                            <i class="las la-hands-helping text-dark"></i>
                        </div>
                    </div>
                    <div class="col-7 d-flex align-items-center">
                        <div class="numbers">
                            <p class="card-category">Referans Sayısı</p>
                            <h4 class="card-title" id="testimonialCount"></h4>
                        </div>
                    </div>
                </div>
                <hr />

            </div>
        </div>
    </div>
</div>

