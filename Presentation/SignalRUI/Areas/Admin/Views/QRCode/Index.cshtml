@{
	ViewData["Title"] = "Index";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="card">
	<div class="card-body">
		<form method="post" asp-action="Index" asp-controller="QRCode">
			<div class="form-group">
				<input type="text" name="value" class="form-control" />
				<input type="submit" value="QR Kod Oluştur" class="btn btn-primary mt-2" />
			</div>
			@if (ViewBag.QRCodeImage != null)
			{
				<img src="@ViewBag.QRCodeImage" alt="" style="width:400px; height:400px;" />
			}
		</form>
		
	</div>
</div>


