@model RegisterDto
@{
    Layout = null;
}
<style>
	.custom-background {
		background: rgb(13,13,12);
		background: linear-gradient(90deg, rgba(13,13,12,1) 27%, rgba(60,59,59,1) 59%) !important;
	}
</style>

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>TastyGo Kayıt</title>
	<!-- Mobile Specific Metas -->
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<link rel="shortcut icon" href="~/feane-1.0.0/images/favicon.png" type="">

	<!-- Font-->
	<link rel="stylesheet" type="text/css" href="~/colorlib-regform-32/css/nunito-font.css">
	<!-- Main Style Css -->
	<link rel="stylesheet" href="~/colorlib-regform-32/css/style.css" />
</head>
<body class="form-v6">
	<div class="page-content custom-background">
		<div class="form-v6-content">
			<div class="form-left">
				<img src="~/colorlib-regform-32/images/Pizza1.jpg" height="672" width="484" alt="form">
			</div>
			<form class="form-detail" method="post">
				<h2>Yeni Kullanıcı Kaydı</h2>
				<div class="form-row">
					<input type="text" class="input-text" placeholder="Adınız" asp-for="Firstname" required>
				</div>
				<div class="form-row">
					<input type="text" class="input-text" placeholder="Soyadınız" asp-for="Lastname" required>
				</div>
				<div class="form-row">
					<input type="text" class="input-text" placeholder="Kullanıcı Adı" asp-for="Username" required>
				</div>
				<div class="form-row">
					<input type="email" class="input-text" placeholder="Email Adresi" asp-for="Email" required pattern="[^@@]+@@[^@@]+.[a-zA-Z]{2,6}">
				</div>
				<div class="form-row">
					<input type="password" class="input-text" placeholder="Şifre" asp-for="Password" required>
				</div>

				<div class="form-row-last">
					<input type="submit" name="register" class="register" value="Kayıt Ol">
				</div>
			</form>
		</div>
	</div>
</body><!-- This templates was made by Colorlib (https://colorlib.com) -->
</html>