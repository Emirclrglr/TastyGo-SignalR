<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script type="text/javascript">
		$(document).ready(() => {
		var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:44314/SignalRHub").build();

		connection.start().then(() => {
			setInterval(() => {
				connection.invoke("SendNotification")
			})
		}).catch((err) => {
			console.log(err)
		});

		connection.on("ReceiveUnreadMessageCount", (unreadMessageCountValue) => {
			$("#notificationCount").text(unreadMessageCountValue);
		});

		connection.on("ReceiveNewNotificationCount", (newNotification) => {
			$("#newNotificationCount").text(newNotification);
		});

		connection.on("ReceiveUnreadNotificationList", (unreadNotificationListValues) => {
			$("#notiList").empty();
			for(var i = 0; i < unreadNotificationListValues.length; i++){
				$("#notiList").append(`
				<a href="#">
					<div class="${unreadNotificationListValues[i].type}"> <i class="${unreadNotificationListValues[i].icon}"></i> </div>
						<div class="notif-content">
							<span class="block">
								${unreadNotificationListValues[i].description}
							</span>
						<span class="time">${unreadNotificationListValues[i].date}</span>
					</div>
				</a>`);
			};
		});

		// <a href="#">
		// 	<div class="notif-icon notif-primary"> <i class="la la-user-plus"></i> </div>
		// 	<div class="notif-content">
		// 		<span class="block">
		// 			New user registered
		// 		</span>
		// 		<span class="time">5 minutes ago</span>
		// 	</div>
		// </a>
	});
</script>

