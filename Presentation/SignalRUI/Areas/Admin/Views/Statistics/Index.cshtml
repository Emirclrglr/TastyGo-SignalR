@{
	ViewData["Title"] = "Index";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script type="text/javascript">
		$(document).ready(() => {
		var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:44314/SignalRHub").build();

		connection.start().then(() => {

			setInterval(() => {
				connection.invoke("SendStatistics");
			}, 1000);


		}).catch((err) => {
			console.log(err);
		})

		connection.on("ReceiveCategoryCount", (categoryCountValue) => {
			$("#categoryCount").text(categoryCountValue);
		});

		connection.on("ReceiveProductCount", (productCountValue) => {
			$("#productCount").text(productCountValue);
		})

		connection.on("ReceiveActiveCategoryCount", (activeCategoryCountValue) => {
			$("#activeCategoryCount").text(activeCategoryCountValue);
		})

		connection.on("ReceivePassiveCategoryCount", (passiveCategoryCountValue) => {
			$("#passiveCategoryCount").text(passiveCategoryCountValue);
		})

		connection.on("ReceiveHamburgerCount", (hamburgerCountValue) => {
			$("#hamburgerCount").text(hamburgerCountValue);
		})

		connection.on("ReceiveDrinkCount", (drinkCountValue) => {
			$("#drinkCount").text(drinkCountValue);
		})

		connection.on("ReceiveAverageProductPrice", (averageProductPriceValue) => {
			$("#avgProductPrice").text(averageProductPriceValue);
		})

		connection.on("ReceiveMostExpensiveProduct", (mostExpensiveProductValue) => {
			$("#mostExpensiveProduct").text(mostExpensiveProductValue);
		})

		connection.on("ReceiveCheapestProduct", (cheapestProductValue) => {
			$("#cheapsetProduct").text(cheapestProductValue);
		})

		connection.on("ReceiveAverageHamburgerPrice", (avgHamburgerPriceValue) => {
			$("#avgHamburgerPrice").text(avgHamburgerPriceValue);
		})

		connection.on("ReceiveTotalOrderCount", (totalOrderCountValue) => {
			$("#orderCount").text(totalOrderCountValue);
		})

		connection.on("ReceiveActiveOrderCount", (activeOrderCountValue) => {
			$("#activeOrderCount").text(activeOrderCountValue);
		})

		connection.on("ReceiveTotalPriceOfLatestOrder", (lastOrderPriceValue) => {
			$("#lastOrderPrice").text(lastOrderPriceValue);
		})

		connection.on("ReceiveMoneySafeTotalAmount", (moneySafeTotalAmountValue) => {
			$("#moneySafeTotalAmount").text(moneySafeTotalAmountValue);
		})

		connection.on("ReceiveTodaysEarnings", (todaysEarningsValue) => {
			$("#todaysEarnings").text(todaysEarningsValue);
		})

		connection.on("ReceiveDiningTableCount", (diningTableCountValue) => {
			$("#diningTableCount").text(diningTableCountValue);
		})
	});</script>

