@model CreateMessageDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

@await Component.InvokeAsync("_UINavbarViewPartial")

<section class="book_section layout_padding">
	<div class="container">
		<div class="heading_container">
			<h2>
				Bize Ulaşın
			</h2>
		</div>
		<div class="row">
			<div class="col-md-6">
				<div class="form_container">
					<form id="messageForm" method="post">
						<div>
							<input type="text" class="form-control" placeholder="Adınız" asp-for="Name" required />
						</div>
						<div>
							<input type="tel" class="form-control" placeholder="Telefon Numarası" asp-for="Phone" required />
						</div>
						<div>
							<input type="email" class="form-control" placeholder="Email Adresi" required asp-for="Email" />
						</div>
						<div>
							<input type="text" class="form-control" placeholder="Konu" required asp-for="Subject" />
						</div>
						<div>
							<textarea class="form-control" style="height: 150px" asp-for="MessageBody" placeholder="Mesajınız"></textarea>
						</div>
						<div class="btn_box">
							<button type="submit">
								Gönder
							</button>
						</div>
					</form>
				</div>
			</div>
			<div class="col-md-6">
				<div class="map_container ">
					<div id="googleMap"></div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.getElementById("messageForm").addEventListener("submit", function(event) {
		event.preventDefault();

		var formData = new FormData(this);

		fetch(this.action, {
			method: "POST",
			body: formData,
			headers: {
				"Accept": "application/json"
			}
		})
		.then(response => {
			if (response.ok) {

				Swal.fire({
					icon: 'success',
					title: 'Mesajınız Gönderildi!',
					confirmButtonText: 'Tamam'
				});
			} else {
				Swal.fire({
					icon: 'error',
					title: 'Hata!',
					text: 'Mesajınız Gönderilirken bir hata oluştu. Lütfen tekrar deneyin.',
					confirmButtonText: 'Tamam'
				});
			}
		})
		.catch(error => {
			Swal.fire({
				icon: 'error',
				title: 'Hata!',
				text: 'Sunucuyla iletişimde bir sorun oluştu. Lütfen tekrar deneyin.',
				confirmButtonText: 'Tamam'
			});
		});
	});
</script>

