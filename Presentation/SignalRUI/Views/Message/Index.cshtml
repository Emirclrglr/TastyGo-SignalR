@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_UILayout.cshtml";
}
@await Component.InvokeAsync("_UINavbarViewPartial")

<div class="container">
	<div class="card m-5 p-3">
		<div class="card-body">
			<div class="text-center"><h2 class="mb-4">TastyGo Mesaj Sayfası</h2></div>
			<hr />
			<div class="row justify-content-center mt-5">
				<div class="col-6">
					<div class="form-group text-right mt-2">
						<p>Kullanıcı Adınız:</p>
						<p>Mesajınız:</p>
					</div>
				</div>
				<div class="col-6">
					<div class="form-group text-left">
						<input type="text" class="form-control w-50" id="userNameInput" />
						<input type="text" class="form-control w-50 mt-2" id="messageInput" />
					</div>
				</div>
			</div>
			<div class="row justify-content-center text-right">
				<div class="col-7">
					<button type="submit" id="btnSendMessage" class="btn btn-outline-warning rounded-pill px-5 mr-4">Gönder</button>
				</div>
			</div>
			<hr />
			<div class="row justify-content-center">
				<div class="col-12">
					<ul id="messageList" class="list-group"></ul>
				</div>
			</div>
		</div>
	</div>
</div>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/chat.js"></script>