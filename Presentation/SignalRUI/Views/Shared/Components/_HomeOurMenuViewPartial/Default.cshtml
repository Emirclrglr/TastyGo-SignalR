											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
																	  </svg>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>

				}

			</div>
		</div>
	</div>
</section>

<script type="text/javascript">
		function showProductId(productId, menuTableId){
		$.ajax({
			type:'POST',
			url: "/Menu/AddToBasket/",
			data: { 
				id : productId,
				menuTableId : menuTableId
			},
			success: function(){
					Swal.fire({
					title: "Ürün Sepete Eklendi",
					icon: "success"
				});

			}
		});
	}
</script>