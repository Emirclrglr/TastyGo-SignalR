@using System.Globalization
@model IEnumerable<ResultProductDto>
@{
	CultureInfo cultureInfo = new CultureInfo("tr-TR");
	cultureInfo.NumberFormat.CurrencyPositivePattern = 3;
}

<style>
	.food_section .box .img-box {
		display: block;
		text-align: center;
		overflow: hidden;
	}

		.food_section .box .img-box img {
			white-space: break-spaces;
			max-height: 250px;
			height: 700px;
			width: 500px;
			object-fit: fill;
			object-position: center
		}

	.basket {
		cursor: pointer;
		transition: all .5s ease-in-out;
		background: #ffbe33 !important;
	}

		.basket:hover {
			background: #FF8833 !important;
		}

</style>
<section class="food_section layout_padding-bottom mt-5">
	<div class="container">
		<div class="heading_container heading_center">
			<h2>
				Menü
			</h2>
		</div>

		<ul class="filters_menu">
			<li class="active" data-filter="*">Tümü</li>
			@foreach (var categoryItems in Model.Select(x=>x.CategoryName).Distinct())
			{
				<li data-filter=".@categoryItems">@categoryItems</li>
			}
		</ul>

		<div class="filters-content">
			<div class="row grid">
				@foreach (var item in Model)
				{
					string foodClass = item.CategoryName;
					

					<div class="col-sm-6 col-lg-4 all @foodClass">
						<div class="box">
							<div>
								<div class="img-box p-0">
									<img src="@item.ImageUrl" alt="">
								</div>
								<div class="detail-box">
									<h5>
										@item.ProductName
									</h5>
									<p>
										@item.Description
									</p>
									<div class="options">
										<h6>
											@item.ProductPrice.ToString("C2", cultureInfo)
										</h6>
										<a class="basket" onclick="showProductId(@item.Id, @ViewBag.v)">
											<svg version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 456.029 456.029" style="enable-background:new 0 0 456.029 456.029;" xml:space="preserve">
											<g>
											<g>
											<path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248
                         c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
																		  </g>
																		</g>
											<g>
											<g>
											<path d="M439.296,84.91c-1.024,0-2.56-0.512-4.096-0.512H112.64l-5.12-34.304C104.448,27.566,84.992,10.67,61.952,10.67H20.48
                         C9.216,10.67,0,19.886,0,31.15c0,11.264,9.216,20.48,20.48,20.48h41.472c2.56,0,4.608,2.048,5.12,4.608l31.744,216.064
                         c4.096,27.136,27.648,47.616,55.296,47.616h212.992c26.624,0,49.664-18.944,55.296-45.056l33.28-166.4
                         C457.728,97.71,450.56,86.958,439.296,84.91z" />
																		  </g>
																		</g>
											<g>
											<g>
											<path d="M215.04,389.55c-1.024-28.16-24.576-50.688-52.736-50.688c-29.696,1.536-52.224,26.112-51.2,55.296
                         c1.024,28.16,24.064,50.688,52.224,50.688h1.024C193.536,443.31,216.576,418.734,215.04,389.55z" />
																		  </g>
																		</g>
											<g>
																		</g>
											<g>
																		</g>
											<g>
